{
  "expo": {
    "name": "Robo Defense",
    "slug": "robodefense",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/ui/icon.png",
    "scheme": "robodefense",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070D",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "me.llkirkwood.robodefense",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "me.llkirkwood.robodefense",
      "adaptiveIcon": {
        "backgroundColor": "#05070D",
        "foregroundImage": "./assets/ui/splash-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/ui/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070D",
          "image": "./assets/ui/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-audio",
      "expo-sqlite",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "40589dd7-144d-46f3-892e-ef580518e5b2"
      }
    },
    "owner": "llkirkwood119"
  }
}
